{
  "manifest_version": 3,
  "name": "Image Studio DHL - Local",
  "version": "2.0.0",
  "version_name": "2.0.0 • R19.9-FFMPEG-AUDIO",
  "description": "Image Studio chạy local. Cập nhật bằng GitHub Desktop Pull origin rồi Reload extension.",
  "permissions": [
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mở Image Studio DHL"
  }
}
