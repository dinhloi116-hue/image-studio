{
  "manifest_version": 3,
  "name": "DHL Image Studio | Chỉnh ảnh hàng loạt",
  "version": "2.0.8",
  "version_name": "2.0.8 • R20.22-PATCH-RULER-AUTO-TONE",
  "description": "Image Studio chạy local. Cập nhật bằng GitHub Desktop Pull origin rồi Reload extension.",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DHL Image Studio — Chỉnh ảnh hàng loạt",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
